# TiDB Cloud Serverless Connection
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<your-tidb-prefix>.root
TIDB_PASSWORD=<your-tidb-password>
TIDB_DATABASE=grandmaster_atelier
TIDB_SSL=true
# Opsional: path lokal ke isrgrootx1.pem jika diperlukan
TIDB_CA_PATH=

# Google OAuth 2.0 Login (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# String acak panjang minimal 32 karakter untuk menandatangani cookie sesi
AUTH_SESSION_SECRET=
# Opsional: isi di produksi (mis. https://catur.domainkamu.com)
APP_ORIGIN=
